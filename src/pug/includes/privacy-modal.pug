#privacyModal.portfolio-modal.modal.fade(tabindex='-1', role='dialog', aria-hidden='true')
    .modal-dialog
        .modal-content
            .close-modal(data-bs-dismiss='modal')
                button.btn-close(type='button', aria-label='Close')
            .container
                .row.justify-content-center
                    .col-lg-8
                        .modal-body
                            h2.text-uppercase Privacy Policy
                            p.item-intro.text-muted This site does not log or share your personal information.
                            p We don't track you. We don't profile you.
